package views

templ MovieForm() {
	<article>
		<h2>Agregar película</h2>
		<form method="post" action="/movies">
			<label>
				Título
				<input type="text" name="title" maxlength="255" placeholder="Interstellar" required/>
			</label>
			<label>
				Descripción
				<input type="text" name="description" maxlength="255" placeholder="Ciencia ficción" required/>
			</label>
			<div class="grid">
				<label>
					Fecha de estreno
					<input type="date" name="release_date" required/>
				</label>
				<label>
					Duración (minutos)
					<input type="number" name="duration" min="1" placeholder="120" required/>
				</label>
			</div>
			<button type="submit">Agregar</button>
		</form>
	</article>
}