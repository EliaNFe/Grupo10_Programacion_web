package views

templ MovieForm() {
	<article>
		<h2>Agregar película</h2>
		<!-- 
			hx-post: envía la petición por AJAX (por detrás) al servidor
			hx-target: apunta a qué elemento va a modificar(#movie-list)
			hx-swap: reemplaza el elemento entero viejo por el nuevo que manda el sv
			hx-on::after-request: si la petición fue exitosa, limpia los campos del formulario
		-->
		<form
			method="post"
			action="/movies"
			hx-post="/movies"
			hx-target="#movie-list"
			hx-swap="outerHTML"
			hx-on::after-request="if(event.detail.successful) this.reset()"
		>
			<label>
				Título
				<input type="text" name="title" maxlength="255" placeholder="Interstellar" required/>
			</label>
			<label>
				Descripción
				<input type="text" name="description" maxlength="255" placeholder="Ciencia ficción" required/>
			</label>
			<div class="grid">
				<label>
					Fecha de estreno
					<input type="date" name="release_date" required/>
				</label>
				<label>
					Duración (minutos)
					<input type="number" name="duration" min="1" placeholder="120" required/>
				</label>
			</div>
			<button type="submit">Agregar</button>
		</form>
	</article>
}